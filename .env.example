# Copy to .env and fill in values. Never commit real secrets.

# --- MCP transport ---
# stdio | streamable-http
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
MCP_HTTP_PATH=/mcp
# Required for non-localhost / production HTTP deployments (Bearer token)
MCP_AUTH_TOKEN=
# Production containers typically set MCP_HTTP_HOST=0.0.0.0 and:
MCP_ALLOW_REMOTE_BIND=false

# --- Database ---
DATABASE_PATH=data/runtime/event_seo.db

# --- AI providers ---
# openai | anthropic | gemini | template
AI_PROVIDER=template
AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# --- Execution safety ---
DRY_RUN_DEFAULT=true
REQUIRE_PUBLICATION_AUTHORIZATION=true
MAX_CONCURRENT_BROWSER_SESSIONS=1
EXECUTION_TIMEOUT_SECONDS=120
RATE_LIMIT_REQUESTS_PER_MINUTE=30
LOG_LEVEL=INFO

# --- Browser / Playwright ---
PLAYWRIGHT_HEADLESS=true
BROWSER_SESSION_DIR=data/browser-sessions
EVIDENCE_DIR=data/evidence

# --- Eventbrite API (official v3; local/dev only until you approve live) ---
# Private token from https://www.eventbrite.com/platform/api-keys/ (never commit real values)
EVENTBRITE_API_TOKEN=
# Organization ID (GET /v3/users/me/organizations/ with the token, or Eventbrite UI)
EVENTBRITE_ORGANIZATION_ID=
# ISO 4217 currency required by create-event (default USD)
EVENTBRITE_CURRENCY=USD
# false = draft create + ticket class only; true = also call publish after create
EVENTBRITE_PUBLISH_ON_CREATE=false
# Override only if Eventbrite documents a different host (default official API)
EVENTBRITE_API_BASE_URL=https://www.eventbriteapi.com/v3

# --- Meetup (placeholder; API/auth NEEDS_VERIFICATION — do not invent endpoints) ---
MEETUP_OAUTH_ACCESS_TOKEN=
MEETUP_CLIENT_ID=
MEETUP_CLIENT_SECRET=

# --- DEV Community / Forem API (placeholder; live not verified) ---
DEVTO_API_KEY=

# --- LinkedIn OAuth (placeholder; posting NEEDS_VERIFICATION — official docs only) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATION_URN=

# --- Optional integrations (soft-fail when unset/unavailable) ---
BROWSER_USE_ENABLED=false
CRAWL4AI_ENABLED=false
AGNO_ENABLED=false
SKYVERN_ENABLED=false
SKYVERN_API_URL=
SKYVERN_API_KEY=

# --- Google Sheets (service account; never commit the key) ---
# Spreadsheet the MCP reads for targets and writes for submission tracking.
GOOGLE_SHEETS_SPREADSHEET_ID=1yJa403y9bDLorNG-ahv2SArlYe5MiUSNgwd7TpoPC0M
# Inline service-account JSON, or leave empty and set GOOGLE_APPLICATION_CREDENTIALS to a key file path.
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEETS_CREDENTIALS_TAB=Site Login Credentials
GOOGLE_SHEETS_SUBMISSIONS_TAB=Submissions

# --- Backlink verification ---
BACKLINK_MAX_REDIRECTS=5
BACKLINK_TIMEOUT_SECONDS=20
BACKLINK_USER_AGENT=EventSeoMCP/0.1 (+https://github.com/eneelkant/event-off-page-seo-automation)
